# ─────────────────────────────────────────
#  APP
# ─────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
APP_NAME="CMS Backend"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ─────────────────────────────────────────
#  JWT
# ─────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────
#  OTP / 2FA
# ─────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10
TOTP_ISSUER="CMS App"

# ─────────────────────────────────────────
#  SENDGRID
# ─────────────────────────────────────────
SENDGRID_API_KEY=SG.CHANGE_ME
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
SENDGRID_FROM_NAME="CMS App"
SENDGRID_TEMPLATE_OTP=d-CHANGE_ME
SENDGRID_TEMPLATE_WELCOME=d-CHANGE_ME
SENDGRID_TEMPLATE_RESET_PASSWORD=d-CHANGE_ME

# ─────────────────────────────────────────
#  POSTGRESQL
# ─────────────────────────────────────────
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=cms_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cms_user:CHANGE_ME_postgres_password@postgres:5432/cms_db?schema=public

# ─────────────────────────────────────────
#  REDIS
# ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379

# ─────────────────────────────────────────
#  MONGODB (analytics)
# ─────────────────────────────────────────
MONGO_USER=cms_mongo
MONGO_PASSWORD=CHANGE_ME_mongo_password
MONGO_DB=cms_analytics
MONGO_PORT=27017
MONGODB_URL=mongodb://cms_mongo:CHANGE_ME_mongo_password@mongodb:27017/cms_analytics?authSource=admin

# ─────────────────────────────────────────
#  MINIO / S3
# ─────────────────────────────────────────
MINIO_USER=cms_minio
MINIO_PASSWORD=CHANGE_ME_minio_password
MINIO_PORT=9000
MINIO_ENDPOINT=minio
MINIO_USE_SSL=false
S3_BUCKET_PUBLIC=cms-public
S3_BUCKET_PRIVATE=cms-private
S3_REGION=us-east-1

# ─────────────────────────────────────────
#  ELASTICSEARCH
# ─────────────────────────────────────────
ELASTIC_HOST=http://elasticsearch:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=CHANGE_ME_elastic_password
ELASTIC_PORT=9200

# ─────────────────────────────────────────
#  RATE LIMITING
# ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# ─────────────────────────────────────────
#  UPLOADS
# ─────────────────────────────────────────
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm

# ─────────────────────────────────────────
#  MONITORING
# ─────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password
METRICS_PORT=9100
